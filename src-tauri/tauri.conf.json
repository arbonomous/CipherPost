{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CipherPost",
  "version": "0.1.0",
  "identifier": "app.cipherpost.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CipherPost",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#090a0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:*; frame-src 'self' data: blob:; object-src 'none'; base-uri 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Zero-Trust, Local-First Desktop Email Client",
    "longDescription": "CipherPost is a local-first, privacy-hardened macOS email client with encrypted SQLCipher storage, FTS5 instant search, active tracker stripping, and native IMAP/SMTP sync.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": [],
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
